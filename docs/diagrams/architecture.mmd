flowchart TB
    USER(["👤 user"]):::user

    subgraph PKG["src/localcaption/ · Python package"]
        direction TB

        subgraph ENTRY["entry points"]
            direction LR
            CLI["cli.py<br/><i>argparse · main()</i>"]:::entry
            MAIN["__main__.py<br/><i>python -m localcaption</i>"]:::entry
        end

        PIPE["pipeline.py<br/><b>transcribe_url()</b><br/><i>public Python API</i>"]:::core

        subgraph STAGES["pipeline stages · single responsibility"]
            direction LR
            DL["download.py<br/><i>yt-dlp · proxy</i>"]:::stage
            AU["audio.py<br/><i>ffmpeg → 16 kHz WAV</i>"]:::stage
            LID["langid.py<br/><i>language ID</i>"]:::stage
            ASR["asr.py<br/><i>routing + artefacts</i>"]:::stage
        end

        subgraph RUNNERS["runners/ · executed inside each venv"]
            direction LR
            RL["langid.py<br/><i>speechbrain ECAPA</i>"]:::runner
            RQ["qwen.py<br/><i>Qwen3-ASR</i>"]:::runner
            RN["nvidia.py<br/><i>Parakeet · Nemotron</i>"]:::runner
        end

        subgraph SUPPORT["support modules · used by all stages"]
            direction LR
            MOD["models.py · runtime.py<br/><i>registry · venvs</i>"]:::support
            NET["network.py · paths.py<br/><i>proxy · layout</i>"]:::support
            MISC["languages.py · formats.py<br/>chapters.py · index.py<br/>summary.py · errors.py"]:::support
        end
    end

    subgraph EXT["external dependencies · built / fetched on install"]
        direction LR
        YTDLP(["📦 yt-dlp<br/><i>pip dependency</i>"]):::extdep
        FFMPEG(["⚙️ ffmpeg<br/><i>system binary</i>"]):::extdep
        PROXY(["🔒 SOCKS5 proxy<br/><i>all network traffic</i>"]):::extdep
        CKPT[/"🧠 4 checkpoints<br/><i>models/</i>"/]:::model
        VENVS[/"🐍 3 virtualenvs<br/><i>runtime/</i>"/]:::model
    end

    USER ==>|"localcaption <url>"| CLI
    USER ==>|"python -m localcaption"| MAIN
    MAIN --> CLI
    CLI ==>|"transcribe_url(...)"| PIPE
    PIPE ==> DL
    PIPE ==> AU
    PIPE ==> LID
    PIPE ==> ASR

    LID --> RL
    ASR --> RQ
    ASR --> RN

    DL  --> YTDLP
    AU  --> FFMPEG
    DL  -.-> PROXY
    RUNNERS -.-> VENVS
    RUNNERS --> CKPT

